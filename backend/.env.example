PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=contatask_secret_jwt_key_2026_sunat_secure
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Base de datos PostgreSQL con Knex.js
DB_CLIENT=pg
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=contatask_db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contatask_db

# Configuración de Correo SMTP (Nodemailer)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ContaTask Alertas" <alertas@contatask.pe>
